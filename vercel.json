{
  "installCommand": "pnpm install",
  "buildCommand": "cd artifacts/dean-dashboard && pnpm exec vite build --config vite.config.ts",
  "outputDirectory": "artifacts/dean-dashboard/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/pq-news", "destination": "/api/pq-news" },
    { "source": "/api/pq-news/refresh", "destination": "/api/pq-news?refresh=true" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
